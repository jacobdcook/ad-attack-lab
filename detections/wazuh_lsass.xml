<!-- Wazuh local rule: LSASS memory access via Sysmon Event 10 (credential dumping) -->
<!-- Place in /var/ossec/etc/rules/local_rules.xml. Requires Sysmon + wazuh agent. -->
<group name="sysmon,windows,credential_access,">
  <rule id="100150" level="12">
    <if_group>sysmon_event_10</if_group>
    <field name="win.eventdata.targetImage">lsass\.exe$</field>
    <field name="win.eventdata.grantedAccess">0x1010|0x1410</field>
    <description>Credential dumping: suspicious process accessed LSASS memory ($(win.eventdata.sourceImage))</description>
    <mitre>
      <id>T1003.001</id>
    </mitre>
  </rule>
</group>
